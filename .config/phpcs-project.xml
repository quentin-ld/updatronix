<?xml version="1.0"?>
<!--
	Project-specific PHP_CodeSniffer exceptions.

	This file was seeded by `bin/harness sync` and will never be written again.
	It is included by `.config/phpcs.xml`, which IS regenerated on every sync —
	put your own exceptions here rather than in there, where they would be
	overwritten.

	Two rules of thumb before adding one:

	- An exclusion is a decision, not a fix. Say why, in a comment here, the
	  way the generated ruleset does for `tests/stubs`.
	- Exclude the narrowest thing that covers the case. Turning off a whole
	  sniff for the whole project hides every future violation of it, including
	  the ones you would have wanted to see.

	Two shapes work:

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/inc/snippets/meta/*</exclude-pattern>
	</rule>

	<rule ref="Squiz.Commenting.InlineComment">
		<severity>0</severity>
	</rule>
-->
<ruleset name="updatronix-project">
	<!--
		Test support fixtures use PascalCase file names by convention; the
		WordPress file-name sniff expects class-*.php. Keep the other sniffs
		active for tests, but exclude these fixtures from the naming rule.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/Support/*</exclude-pattern>
	</rule>
	<!--
		Test-book PHP files are WP-CLI eval fixtures, not plugin code. Their
		docblock is a file comment, but the Squiz file-comment sniff does not
		recognize the eval-file shape. Exclude only that rule for this folder.
	-->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>*/tests/testbook/php/*</exclude-pattern>
	</rule>
	<!--
		This unit test deliberately declares small WordPress/log-state stubs
		alongside the test class so the logger failure path can run without a
		full WordPress runtime. The one-object/function and file-name rules do
		not apply to that test fixture shape.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/Unit/UpdateLoggerFailureTest.php</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/Unit/UpdateLoggerFailureTest.php</exclude-pattern>
	</rule>
	<rule ref="Generic.Files">
		<exclude-pattern>*/tests/Unit/UpdateLoggerFailureTest.php</exclude-pattern>
	</rule>
	<!--
		The logger predates the 100-character rule and carries a large
		pre-existing line-length backlog. Keep the rule everywhere else.
	-->
	<rule ref="Generic.Files.LineLength">
		<exclude-pattern>*/inc/classes/class-updatronix-update-logger.php</exclude-pattern>
	</rule>
	<!--
		The project standard enables both EndFileNewline and EndFileNoNewline.
		Keep the standard newline rule for this file and drop the contradictory
		no-newline rule.
	-->
	<rule ref="Generic.Files.EndFileNoNewline">
		<exclude-pattern>*/inc/classes/class-updatronix-update-logger.php</exclude-pattern>
	</rule>
</ruleset>
