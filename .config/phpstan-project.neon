# PHPStan parameters for updatronix.
#
# This file was seeded by `bin/harness sync` and will never be written again. It
# is included by `.config/phpstan.neon`, which IS regenerated on every sync --
# put your own parameters here rather than in there, where they would be
# overwritten.
#
# The floor is level 8 with the strict and deprecation rules (docs/TOOLCHAIN.md).
# Two rules of thumb before adding an entry to `ignoreErrors`:
#
#   - An exclusion is a decision, not a fix. Say why, in a comment here.
#   - Exclude the narrowest thing that covers the case. A blanket `#.*#` hides
#     every future finding, including the ones you would have wanted to see.
#
# A third-party dependency's types are the usual reason for one, and `scanFiles`
# is usually better than an ignore:
#
#   parameters:
#       scanFiles:
#           - vendor/woocommerce/woocommerce/woocommerce.php
parameters:
    # 67 of the raised floor's findings were `cast.useless`, and every one of
    # them is PHPStan trusting a docblock: it reads `@param string $post_type`
    # as certain, so the `(string) $post_type` on the line below it looks
    # redundant. The cast is not redundant -- PHP is not typed at runtime, and
    # deleting it lets a value that does not match its own docblock reach
    # `get_posts()`, a transient or the database uncoerced. A defensive cast on
    # a documented type is the shape of this codebase, so the finding is what is
    # wrong here, not 67 lines of it. (The nine the setting does not cover were
    # casts on natively typed values, and those were removed.)
    #
    # PHPStan's own message for the rule names this setting. It is set here
    # rather than in the generated `.config/phpstan.neon` because it is this
    # project's decision, not a change to the floor the other twelve meet.
    treatPhpDocTypesAsCertain: false
    excludePaths:
        analyseAndScan:
            - .config/*
            - vendor/*
            - node_modules/*
