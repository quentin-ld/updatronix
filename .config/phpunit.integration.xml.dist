<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../tests/bootstrap.php"
         colors="true"
         beStrictAboutOutputDuringTests="true">
    <php>
        <env name="UPDATRONIX_INTEGRATION_TESTS" value="1"/>
    </php>
    <testsuites>
        <testsuite name="integration">
            <directory>../tests/Integration</directory>
        </testsuite>
    </testsuites>
    <!--
        Coverage collection is active only when a coverage driver (xdebug/pcov)
        is enabled; see `composer test:coverage:integration` and
        .github/workflows/test.yml. The integration run loads the full plugin,
        so this also covers the same source paths as the unit suite.
    -->
    <coverage>
        <include>
            <directory suffix=".php">../inc</directory>
            <file>../updatronix.php</file>
            <file>../uninstall.php</file>
        </include>
        <report>
            <clover outputFile="../.cache/coverage/integration.xml"/>
            <text outputFile="../.cache/coverage/integration.txt"/>
        </report>
    </coverage>
</phpunit>
